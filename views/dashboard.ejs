<%- include('partials/header') %>

<div class="wrap">
  <div class="list-head">
    <h1 class="page-title"><%= t('welcome') %>, <%= user.name %></h1>
    <a class="btn btn-primary" href="/deposer">+ <%= t('post_ad') %></a>
  </div>

  <% if (!listings.length) { %>
    <div class="empty">
      <p class="empty-title"><%= t('dashboard_empty') %></p>
      <a class="btn btn-primary" href="/deposer"><%= t('post_ad') %></a>
    </div>
  <% } else { %>
    <ul class="mylist">
      <% listings.forEach(function (item) { %>
        <li class="myitem">
          <a class="myitem-media" href="/annonce/<%= item.id %>">
            <% if (item.cover) { %><img src="/photos/<%= item.cover %>" alt="" loading="lazy">
            <% } else { %><span class="card-noimg">📷</span><% } %>
          </a>
          <div class="myitem-body">
            <a class="myitem-title" href="/annonce/<%= item.id %>"><%= item.title %></a>
            <p class="myitem-meta">
              <span class="status status-<%= item.status %>"><%= item.status === 'active' ? t('active') : t('sold') %></span>
              · <%= item.price === null ? t('negotiable') : formatPrice(item.price) %>
              · <%= item.views %> <%= t('views') %>
              · <%= timeAgo(item.created_at) %>
            </p>
          </div>
          <div class="myitem-actions">
            <a class="btn btn-sm btn-ghost" href="/annonce/<%= item.id %>/modifier"><%= t('edit') %></a>
            <form method="post" action="/annonce/<%= item.id %>/statut" class="inline">
              <input type="hidden" name="_csrf" value="<%= csrf %>">
              <input type="hidden" name="suite" value="dashboard">
              <button class="btn btn-sm btn-ghost" type="submit">
                <%= item.status === 'active' ? t('mark_sold') : t('mark_active') %>
              </button>
            </form>
            <form method="post" action="/annonce/<%= item.id %>/supprimer" class="inline"
                  onsubmit="return confirm('<%= t('confirm_delete') %>')">
              <input type="hidden" name="_csrf" value="<%= csrf %>">
              <button class="btn btn-sm btn-danger" type="submit"><%= t('delete') %></button>
            </form>
          </div>
        </li>
      <% }) %>
    </ul>
  <% } %>
</div>

<%- include('partials/footer') %>
